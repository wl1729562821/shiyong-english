  "dialogue": {
    "title": "约朋友看电影",
    "other": "朋友",
    "lines": [
      {"s": "o", "en": "Do you want to see a movie this week?", "zh": "这周想去看电影吗？"},
      {"s": "me", "en": "Sure. Which day?", "zh": "好啊，哪天？"},
      {"s": "o", "en": "How about Friday night?", "zh": "星期五晚上怎么样？"},
      {"s": "me", "en": "Sorry, I work late on Fridays. What about Saturday?", "zh": "抱歉，我星期五加班。星期六呢？"},
      {"s": "o", "en": "Saturday afternoon is fine. What time?", "zh": "星期六下午可以。几点？"},
      {"s": "me", "en": "Is three o'clock OK?", "zh": "三点行吗？"},
      {"s": "o", "en": "Perfect. Saturday at three.", "zh": "完美，星期六三点。"},
      {"s": "me", "en": "Great. See you on Saturday!", "zh": "好的，星期六见！"}
