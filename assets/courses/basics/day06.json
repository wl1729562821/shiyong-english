  "dialogue": {
    "title": "同事问你的周末安排",
    "other": "同事",
    "lines": [
      {"s": "o", "en": "What are you doing this weekend?", "zh": "这个周末你干什么？"},
      {"s": "me", "en": "I'm going to Hangzhou.", "zh": "我要去杭州。"},
      {"s": "o", "en": "Nice! Who are you going with?", "zh": "不错！和谁一起去？"},
      {"s": "me", "en": "With my sister.", "zh": "和我姐姐。"},
      {"s": "o", "en": "How are you getting there?", "zh": "怎么去？"},
      {"s": "me", "en": "By high-speed train. It only takes an hour.", "zh": "坐高铁，只要一个小时。"},
      {"s": "o", "en": "When are you coming back?", "zh": "什么时候回来？"},
      {"s": "me", "en": "On Sunday evening.", "zh": "星期天晚上。"},
      {"s": "o", "en": "Why Hangzhou?", "zh": "为什么去杭州？"},
      {"s": "me", "en": "Because my sister wants to see West Lake.", "zh": "因为我姐姐想看西湖。"}
